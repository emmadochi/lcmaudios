// This is your Prisma schema file for PostgreSQL production database deployments.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  song
  sermon
  podcast
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String
  fullName          String
  intentPreferences String[]     @default(["morningDevotion"])
  createdAt         DateTime     @default(now())
  sermonNotes       SermonNote[]
  playlists         Playlist[]
}

model Track {
  id             String       @id @default(uuid())
  title          String
  artist         String
  albumArtUrl    String
  audioUrl       String
  duration       Int
  subgenre       String
  intentCategory String       @default("morningDevotion")
  mediaType      MediaType    @default(song)
  playCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  lyrics         LyricLine[]
  notes          SermonNote[]
}

model Minister {
  id          String   @id @default(uuid())
  name        String
  role        String
  avatarUrl   String
  bio         String   @default("")
  sermonCount Int      @default(0)
  createdAt   DateTime @default(now())
}

model CategoryItem {
  id           String   @id @default(uuid())
  key          String   @unique
  title        String
  subtitle     String
  iconName     String   @default("church")
  gradientName String   @default("purple")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model LyricLine {
  id               String   @id @default(uuid())
  trackId          String
  timestampSeconds Float
  text             String
  track            Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model SermonNote {
  id               String   @id @default(uuid())
  userId           String
  trackId          String
  timestampSeconds Float
  noteText         String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track            Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model Playlist {
  id          String   @id @default(uuid())
  title       String
  userId      String
  isCommunity Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelemetryEvent {
  id                    String   @id @default(uuid())
  trackId               String
  durationPlayedSeconds Float
  timestamp             DateTime @default(now())
  createdAt             DateTime @default(now())
}
